<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ronyxx_setup_view_form" model="ir.ui.view">
        <field name="name">ronyxx.setup.form</field>
        <field name="model">ronyxx.setup</field>
        <field name="arch" type="xml">
            <form string="Connect Ronyxx">
                <sheet>
                    <h2>Give Ronyxx read-only access</h2>
                    <p>Ronyxx answers your team's questions about sales, invoices, stock, purchases and more, with
                        exact figures from this Odoo, on WhatsApp, ChatGPT and Claude.</p>
                    <p>This button creates a group that can only <strong>read</strong> the records Ronyxx answers
                        from (never write, create or delete), a user called "Ronyxx (read-only)" in that group, and an
                        API key for it. You paste the key into Ronyxx. Ronyxx also refuses any change on its own side,
                        so there are two walls instead of one.</p>
                    <div class="alert alert-warning" role="alert">
                        On a paid Odoo plan the Ronyxx user is an internal user, so it counts as one more Odoo user.
                        If you'd rather not add one, use an API key from an existing login instead (Ronyxx's setup page
                        explains both).
                    </div>
                    <group>
                        <field name="key_days"/>
                        <field name="replace_old_keys"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_setup" type="object" string="Create read-only access" class="btn-primary"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ronyxx_setup_view_done" model="ir.ui.view">
        <field name="name">ronyxx.setup.done</field>
        <field name="model">ronyxx.setup</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <form string="Ronyxx access is ready">
                <sheet>
                    <p>Paste these on the <strong>Odoo</strong> page of the Ronyxx console. The key is shown only this
                        once: copy it now.</p>
                    <group>
                        <field name="odoo_url" widget="CopyClipboardChar" readonly="1"/>
                        <field name="database" widget="CopyClipboardChar" readonly="1"/>
                        <field name="login" widget="CopyClipboardChar" readonly="1"/>
                        <field name="api_key" widget="CopyClipboardChar" readonly="1"/>
                        <field name="key_ends" readonly="1"/>
                        <field name="models_count" readonly="1"/>
                    </group>
                    <p>Installed a new app later? Press the button again: Ronyxx gets read access to it, and you can
                        keep the key you have.</p>
                </sheet>
                <footer>
                    <button string="Done" special="cancel" class="btn-primary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="ronyxx_setup_action" model="ir.actions.act_window">
        <field name="name">Connect Ronyxx</field>
        <field name="res_model">ronyxx.setup</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="ronyxx_setup_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="ronyxx_setup_menu" name="Connect Ronyxx" parent="base.menu_administration"
              action="ronyxx_setup_action" sequence="90" groups="base.group_system"/>
</odoo>
